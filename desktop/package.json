{
  "name": "f4-studio-desktop",
  "version": "1.0.0",
  "description": "F4 Studio desktop app (Electron shell around the web build)",
  "author": "F4 Studio",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --win dir",
    "dist:portable": "electron-builder --win portable",
    "dist:store": "electron-builder --win appx",
    "dist:linux": "electron-builder --linux AppImage deb rpm"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "studio.f4.editor",
    "productName": "F4 Studio",
    "artifactName": "F4-Studio-${version}-${arch}.${ext}",
    "copyright": "Copyright © F4 Studio",
    "compression": "normal",
    "directories": { "buildResources": "." },
    "files": ["main.cjs", { "from": "../dist", "to": "dist" }],
    "icon": "icon.ico",
    "fileAssociations": [{ "ext": "f4proj", "name": "F4 Studio project", "role": "Editor" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }, { "target": "appx", "arch": ["x64"] }], "signAndEditExecutable": false },
    "appx": {
      "applicationId": "F4Studio",
      "identityName": "F4Studio.F4Studio",
      "publisher": "CN=F4 Studio",
      "publisherDisplayName": "F4 Studio",
      "displayName": "F4 Studio",
      "backgroundColor": "#0b0b0b",
      "languages": ["en-US"],
      "electronUpdaterAware": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "F4 Studio", "uninstallDisplayName": "F4 Studio", "menuCategory": "Audio & Video" },
    "mac": { "target": ["dmg"], "category": "public.app-category.video" },
    "linux": { "target": ["AppImage", "deb", "rpm"], "category": "AudioVideo", "icon": "../public/icons" }
  }
}
